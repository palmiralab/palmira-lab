# Настройки API. Скопируйте в .env: cp .env.example .env
NODE_ENV=development
PORT=3100
# Логин, пароль и база должны совпадать с POSTGRES_* в корневом .env
DATABASE_URL=postgresql://palmira:change_me@localhost:5432/palmira_lab
# Уведомления о новых лидах в Telegram. Необязательны, но задаются парой:
# токен бота от @BotFather и chat_id чата, куда слать. Без них уведомления
# выключены. Реальные значения только в .env, не сюда.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Почтовый дубль уведомления о заявке (Telegram с сервера нестабилен). Необязателен,
# но задаётся целиком: SMTP_USER, SMTP_PASSWORD и LEAD_EMAIL_TO. Пароль приложения
# Google создаётся в настройках аккаунта; реальные значения только в .env, не сюда.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=
# LEAD_EMAIL_TO=
# LEAD_EMAIL_FROM=
