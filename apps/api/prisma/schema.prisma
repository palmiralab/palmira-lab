generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

// Адрес базы задаётся в prisma.config.ts (так в Prisma 7), не здесь.
datasource db {
  provider = "postgresql"
}

enum ServiceType {
  telegram_automation
  website_landing
  content_automation
  ai_consultation
  manual_review
  out_of_scope

  @@map("service_type")
}

// Жизненный цикл лида: new → contacted → qualified → proposal → won,
// ответвление lost; manual_review — для непонятных или нестандартных запросов.
enum LeadStatus {
  new
  contacted
  qualified
  proposal
  won
  lost
  manual_review

  @@map("lead_status")
}

model Lead {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contact      String
  name         String?
  serviceType  ServiceType @map("service_type")
  budgetHint   String?     @map("budget_hint")
  deadlineHint String?     @map("deadline_hint")
  // Ответы анкеты бесплатного аудита целиком; пусто, пока человек её не
  // проходил. Фиксированный набор вопросов, читаются вместе, поиска по
  // отдельным ответам нет, поэтому JSON, а не отдельная таблица.
  auditAnswers Json?       @map("audit_answers")
  // КП, которое видел клиент на момент заявки, снимком целиком; пусто, если
  // заявка пришла без КП (аудит, manual_review). JSON по той же причине, что
  // и auditAnswers: читается целиком, форма КП может меняться.
  proposal     Json?
  status       LeadStatus  @default(new)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  conversations Conversation[]

  // Список и фильтрация лидов (session-plan §10.2).
  @@index([status, createdAt(sort: Desc)])
  @@map("lead")
}

// Чат-сессия посетителя. Разговор начинается раньше, чем появляется лид
// (контакт человек оставляет в конце), поэтому leadId необязателен.
model Conversation {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadId      String?      @map("lead_id") @db.Uuid
  // Restrict: лида с разговорами удалить нельзя, история остаётся для аналитики.
  lead        Lead?        @relation(fields: [leadId], references: [id], onDelete: Restrict)
  // Идентификатор сессии посетителя (продолжение чата), отдельный от id.
  sessionId   String       @default(dbgenerated("gen_random_uuid()")) @map("session_id") @db.Uuid
  // Шаг сценария; допустимые значения пока в коде, в enum переведём, когда
  // сценарий устоится.
  currentStep String       @map("current_step")
  // Тип услуги; пусто, пока сценарий не определил.
  category    ServiceType?
  completedAt DateTime?    @map("completed_at") @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  // Продолжение пользовательской сессии (session-plan §10.2).
  @@index([sessionId])
  @@map("conversation")
}
