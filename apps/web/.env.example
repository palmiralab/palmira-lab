# Настройки сайта. Скопируйте в .env: cp .env.example .env
# Адрес API вместе с глобальным префиксом /api/v1 (код дописывает только /intake/contact).
API_URL=http://localhost:3100/api/v1
# Ключ авторизации GigaChat (base64 «client_id:client_secret» из кабинета developers.sber.ru).
# Без него чат-ассистент отвечает ошибкой, остальные страницы работают.
# Реальные значения только в .env, не сюда.
GIGACHAT_AUTH_KEY=
# Модель GigaChat; по умолчанию GigaChat-2-Max.
# GIGACHAT_MODEL=GigaChat-2-Max
# Ключ DeepSeek нужен только запасному адаптеру; в боевой маршрут он не подключён.
# DEEPSEEK_API_KEY=
